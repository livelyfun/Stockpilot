# Copy to .env and fill in real values. Never commit .env.
# Connection string consumed by the application (local Podman/Docker PostgreSQL).
ConnectionStrings__DefaultConnection=Host=localhost;Port=55432;Database=stockpilot;Username=stockpilot;Password=change-me

# Initial administrator created on first startup. Use a strong, unique password.
Seed__AdminEmail=admin@example.com
Seed__AdminPassword=change-me-to-a-strong-password
Seed__AdminFullName=System Administrator

# Apply EF Core migrations automatically at startup (development convenience).
Database__AutoMigrate=true
# Seed demonstration master data and transactions (development only).
Seed__DemoData=true

# Production cookie / proxy settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
