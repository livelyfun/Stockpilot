@model UnitFormViewModel
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small" role="alert"></div>
<div class="card form-card">
    <div class="form-section">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label">Unit name <span class="text-danger" aria-hidden="true">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Pieces" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Code" class="form-label">Code <span class="text-danger" aria-hidden="true">*</span></label>
                <input asp-for="Code" class="form-control mono" placeholder="PCS" />
                <span asp-validation-for="Code" class="field-validation-error"></span>
                <div class="form-text">Short code used in tables.</div>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Active</label>
                </div>
            </div>
        </div>
    </div>
    <div class="form-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary" data-loading-label="Saving…">Save unit</button>
    </div>
</div>
