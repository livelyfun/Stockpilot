@model List<Unit>
@{
    ViewData["Title"] = "Units";
    var canManage = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.InventoryStaff);
    var includeInactive = (bool)(ViewBag.IncludeInactive ?? false);
}

<div class="page-header">
    <div>
        <h1>Units of measurement</h1>
        <p>Reusable quantity units referenced by products and stock movements.</p>
    </div>
    @if (canManage)
    {
        <div class="page-actions">
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i> New unit</a>
        </div>
    }
</div>

<div class="card filter-bar section-gap">
    <form method="get" asp-action="Index" class="d-flex align-items-end gap-3 flex-wrap">
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="includeInactive" name="includeInactive" value="true" checked="@includeInactive" />
            <label class="form-check-label" for="includeInactive">Show inactive units</label>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Apply</button>
    </form>
</div>

<div class="card table-card">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-rulers" aria-hidden="true"></i>
            <h3>No units found</h3>
            <p>Create a unit such as Pieces or Box.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>Name</th><th>Code</th><th class="num">Products</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var unit in Model)
                    {
                        <tr>
                            <td class="strong">@unit.Name</td>
                            <td><span class="badge badge-soft-secondary mono">@unit.Code</span></td>
                            <td class="num">@unit.Products.Count</td>
                            <td>
                                @if (unit.IsActive)
                                {
                                    <span class="badge badge-soft-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-secondary">Inactive</span>
                                }
                            </td>
                            <td class="table-actions">
                                @if (canManage)
                                {
                                    <a asp-action="Edit" asp-route-id="@unit.Id" class="btn btn-outline-secondary">Edit</a>
                                    <form asp-action="ToggleActive" asp-route-id="@unit.Id" method="post" class="d-inline"
                                          data-confirm="@(unit.IsActive ? "Deactivate this unit?" : "Activate this unit?")">
                                        <input type="hidden" name="isActive" value="@(!unit.IsActive)" />
                                        <button type="submit" class="btn btn-outline-secondary">@(unit.IsActive ? "Deactivate" : "Activate")</button>
                                    </form>
                                    <form asp-action="Delete" asp-route-id="@unit.Id" method="post" class="d-inline"
                                          data-confirm="Delete this unit? This only works when no products use it.">
                                        <button type="submit" class="btn btn-danger-soft" aria-label="Delete @unit.Name">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
