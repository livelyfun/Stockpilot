@model Purchase
@{
    ViewData["Title"] = Model.PurchaseNumber;
    var canManage = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.InventoryStaff);
    var canReverse = (bool)(ViewBag.CanReverse ?? false);
    var lineCount = Model.Items.Count;
}

<div class="page-header">
    <div>
        <nav aria-label="Breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Purchases</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.PurchaseNumber</li>
        </ol></nav>
        <div class="status-line">
            <h1 class="mb-0 mono">@Model.PurchaseNumber</h1>
            <span class="badge @UiHelpers.PurchaseStatusClass(Model.Status)">@Model.Status</span>
        </div>
        <p>@Model.Supplier.BusinessName · @lineCount line@(lineCount == 1 ? "" : "s") · created @UiHelpers.Date(Model.CreatedAtUtc)</p>
    </div>
    <div class="page-actions">
        @if (canManage && Model.Status == PurchaseStatus.Draft)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <i class="bi bi-pencil me-1" aria-hidden="true"></i> Edit draft
            </a>
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="inline-form"
                  data-confirm="Cancel this draft purchase? No stock has been received yet.">
                <button type="submit" class="btn btn-outline-secondary">Cancel draft</button>
            </form>
            <form asp-action="Receive" asp-route-id="@Model.Id" method="post" class="inline-form"
                  data-confirm="Receive @Model.PurchaseNumber? This will add stock to every line and cannot be repeated.">
                <button type="submit" class="btn btn-primary" data-loading-label="Receiving…">
                    <i class="bi bi-box-arrow-in-down me-1" aria-hidden="true"></i> Receive purchase
                </button>
            </form>
        }
    </div>
</div>

@if (Model.Status == PurchaseStatus.Received)
{
    <div class="callout section-gap">
        <i class="bi bi-check-circle me-1" aria-hidden="true"></i>
        Stock was received @UiHelpers.Date(Model.ReceivedAtUtc) by @(Model.ReceivedByUser?.FullName ?? Model.ReceivedByUser?.UserName ?? "unknown user").
        Each line is posted to the stock ledger exactly once.
    </div>
}
else if (Model.Status == PurchaseStatus.Reversed)
{
    <div class="callout callout-warning section-gap">
        <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>
        This receipt was reversed @UiHelpers.Date(Model.ReversedAtUtc) by @(Model.ReversedByUser?.FullName ?? "an administrator").
        Reason: @(Model.ReversalReason ?? "not recorded")
    </div>
}

<div class="detail-grid section-gap">
    <div class="card table-card">
        <div class="card-header">
            <h2>Order lines</h2>
            <span class="text-muted text-small">Costs are locked to each receipt</span>
        </div>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th class="num">Quantity</th>
                        <th class="num">Unit cost</th>
                        <th class="num">Line total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items.OrderBy(i => i.Product.Name))
                    {
                        <tr>
                            <td>
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="strong link-quiet">@item.Product.Name</a>
                                <span class="table-sub mono">@item.Product.Sku</span>
                            </td>
                            <td class="num">@UiHelpers.Quantity(item.Quantity) <span class="text-muted">@item.Product.Unit.Code</span></td>
                            <td class="num">@UiHelpers.Number(item.UnitCost)</td>
                            <td class="num money">@UiHelpers.Money(item.LineTotal)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end text-muted">Total</td>
                        <td class="num fw-bold">@UiHelpers.Money(Model.TotalAmount)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="card-footer text-muted text-small">
                <i class="bi bi-sticky me-1" aria-hidden="true"></i>@Model.Notes
            </div>
        }
    </div>

    <div class="stack">
        <div class="card">
            <div class="card-header"><h2>Document details</h2></div>
            <div class="card-body">
                <dl class="detail-list">
                    <div>
                        <dt>Supplier</dt>
                        <dd><a asp-controller="Suppliers" asp-action="Details" asp-route-id="@Model.SupplierId">@Model.Supplier.BusinessName</a></dd>
                    </div>
                    <div><dt>Status</dt><dd><span class="badge @UiHelpers.PurchaseStatusClass(Model.Status)">@Model.Status</span></dd></div>
                    <div><dt>Created</dt><dd>@UiHelpers.Date(Model.CreatedAtUtc)</dd></div>
                    <div><dt>Created by</dt><dd>@(Model.CreatedByUser?.FullName ?? Model.CreatedByUser?.UserName ?? "—")</dd></div>
                    <div><dt>Received</dt><dd>@UiHelpers.Date(Model.ReceivedAtUtc)</dd></div>
                    <div><dt>Received by</dt><dd>@(Model.ReceivedByUser?.FullName ?? Model.ReceivedByUser?.UserName ?? "—")</dd></div>
                </dl>
            </div>
        </div>

        @if (canReverse)
        {
            <div class="card">
                <div class="card-header"><h2>Reverse receipt</h2></div>
                <div class="card-body">
                    <p class="text-small text-muted">
                        Reversing removes the received quantities and records compensating ledger entries.
                        It is only permitted while enough stock remains.
                    </p>
                    <form asp-action="Reverse" asp-route-id="@Model.Id" method="post"
                          data-confirm="Reverse @Model.PurchaseNumber? Stock will be reduced and the action is audited.">
                        <div class="mb-2">
                            <label for="reason" class="form-label">Reason <span class="text-danger" aria-hidden="true">*</span></label>
                            <textarea id="reason" name="reason" class="form-control" rows="2" minlength="5" required
                                      placeholder="e.g. Supplier collected the wrong shipment"></textarea>
                        </div>
                        <button type="submit" class="btn btn-danger-soft w-100" data-loading-label="Reversing…">
                            <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i> Reverse receipt
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Back to purchases</a>
</div>
