@model PurchaseFormViewModel
@{
    ViewData["Title"] = "New purchase";
}
<div class="page-header">
    <div>
        <nav aria-label="Breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Purchases</a></li>
            <li class="breadcrumb-item active" aria-current="page">New</li>
        </ol></nav>
        <h1>Draft purchase</h1>
        <p>Select a supplier and add product lines. Receiving is a separate, confirmed step.</p>
    </div>
</div>
<form asp-action="Create" method="post" data-lines-form="purchase" novalidate>
    <partial name="_Form" model="Model" />
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
