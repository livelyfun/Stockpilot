@model CategoryFormViewModel
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small" role="alert"></div>
<div class="card form-card">
    <div class="form-section">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label">Category name <span class="text-danger" aria-hidden="true">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Networking" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Category is active</label>
                </div>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional description"></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>
        </div>
    </div>
    <div class="form-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary" data-loading-label="Saving…">Save category</button>
    </div>
</div>
