@model ErrorViewModel
@{
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
    ViewData["Title"] = "Something went wrong";
}

<div class="card">
    <div class="card-body empty-state">
        <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
        <h3>An unexpected error occurred</h3>
        <p>The request could not be completed. Try again, or contact an administrator if the problem persists.</p>
        @if (Model.ShowRequestId)
        {
            <p class="text-small mono mt-3">Request ID: @Model.RequestId</p>
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Return to dashboard</a>
    </div>
</div>
