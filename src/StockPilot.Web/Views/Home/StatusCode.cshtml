@{
    var code = (int)(ViewData["StatusCode"] ?? 500);
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
    var title = code switch
    {
        403 => "Access denied",
        404 => "Page not found",
        400 => "Invalid request",
        _ => "Request could not be completed"
    };
    var message = code switch
    {
        403 => "Your account does not have permission to view this page.",
        404 => "The page or record you requested does not exist.",
        400 => "The request was rejected. Refresh the page and try again.",
        _ => "Something went wrong while processing your request."
    };
    var icon = code switch
    {
        403 => "bi-shield-lock",
        404 => "bi-compass",
        _ => "bi-exclamation-triangle"
    };
}

<div class="card">
    <div class="card-body empty-state">
        <i class="bi @icon" aria-hidden="true"></i>
        <h3>@title</h3>
        <p>@message</p>
        <p class="text-small text-muted mt-2">HTTP @code</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Return to dashboard</a>
    </div>
</div>
