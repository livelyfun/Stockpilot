@model AdjustmentFormViewModel
@{
    ViewData["Title"] = "Adjust stock";
    var selected = Model.Products.FirstOrDefault(p => p.Id == Model.ProductId);
}

<div class="page-header">
    <div>
        <nav aria-label="Breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Stock movements</a></li>
            <li class="breadcrumb-item active" aria-current="page">Adjust</li>
        </ol></nav>
        <h1>Adjust stock</h1>
        <p>Record a manual increase or decrease with a reason. Every adjustment is audited.</p>
    </div>
</div>

<form asp-action="Adjust" method="post" class="form-grid-2" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small form-grid-full" role="alert"></div>

    <div class="card form-card">
        <div class="form-section">
            <div class="form-section-title">Movement</div>

            <div class="mb-3">
                <label asp-for="ProductId" class="form-label">Product <span class="text-danger" aria-hidden="true">*</span></label>
                <select asp-for="ProductId" class="form-select" data-product-summary>
                    <option value="">Select a product</option>
                    @foreach (var product in Model.Products)
                    {
                        <option value="@product.Id"
                                selected="@(Model.ProductId == product.Id)"
                                data-stock="@product.StockOnHand"
                                data-unit="@product.UnitCode"
                                data-cost="@product.CostPrice">@product.DisplayName</option>
                    }
                </select>
                <span asp-validation-for="ProductId" class="field-validation-error"></span>
            </div>

            <fieldset class="mb-3">
                <legend class="form-label">Direction</legend>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Direction" value="increase" id="direction-increase" />
                        <label class="form-check-label" for="direction-increase">Increase</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Direction" value="decrease" id="direction-decrease" />
                        <label class="form-check-label" for="direction-decrease">Decrease</label>
                    </div>
                </div>
                <span asp-validation-for="Direction" class="field-validation-error"></span>
            </fieldset>

            <div class="row g-3">
                <div class="col-sm-6">
                    <label asp-for="Quantity" class="form-label">Quantity <span class="text-danger" aria-hidden="true">*</span></label>
                    <input asp-for="Quantity" type="number" step="0.001" min="0.001" class="form-control num" />
                    <span asp-validation-for="Quantity" class="field-validation-error"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="UnitCost" class="form-label"></label>
                    <input asp-for="UnitCost" type="number" step="0.01" min="0" class="form-control num"
                           placeholder="Current cost" data-cost-input />
                    <span asp-validation-for="UnitCost" class="field-validation-error"></span>
                    <div class="form-text">Used for increases only.</div>
                </div>
            </div>

            <div class="mt-3">
                <label asp-for="Reason" class="form-label">Reason <span class="text-danger" aria-hidden="true">*</span></label>
                <textarea asp-for="Reason" class="form-control" rows="3" minlength="5"
                          placeholder="e.g. Damaged during handling, cycle count correction"></textarea>
                <span asp-validation-for="Reason" class="field-validation-error"></span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary" data-loading-label="Recording…">
                <i class="bi bi-check2 me-1" aria-hidden="true"></i> Record adjustment
            </button>
        </div>
    </div>

    <div class="stack">
        <div class="card">
            <div class="card-header"><h2>Current position</h2></div>
            <div class="card-body">
                @if (selected is null)
                {
                    <p class="text-muted mb-0">Select a product to see its balance.</p>
                }
                <div class="stat-label">Quantity on hand</div>
                <div class="stat-value">
                    <span data-balance-target>@UiHelpers.Quantity(selected?.StockOnHand ?? 0)</span>
                    <small class="fs-6 text-muted fw-normal" data-unit-target>@(selected?.UnitCode ?? "")</small>
                </div>
                <div class="total-panel mt-3">
                    <div class="total-row"><span>Average cost</span><span class="money">@UiHelpers.Money(selected?.CostPrice ?? 0)</span></div>
                </div>
                @if (selected is not null)
                {
                    <a asp-controller="Products" asp-action="Details" asp-route-id="@selected.Id" class="btn btn-sm btn-outline-secondary mt-3">
                        View product history
                    </a>
                }
            </div>
        </div>

        <div class="callout">
            <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
            Decreases cannot take stock below zero. For corrections, explain the physical count in the reason.
        </div>
    </div>
</form>
