@model ProductFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small" role="alert"></div>

<div class="card form-card">
    <div class="form-section">
        <div class="form-section-title">Product identity</div>
        <div class="row g-3">
            <div class="col-md-5">
                <label asp-for="Sku" class="form-label">SKU <span class="text-danger" aria-hidden="true">*</span></label>
                <input asp-for="Sku" class="form-control mono" placeholder="SP-LAP-001" autocomplete="off" />
                <span asp-validation-for="Sku" class="field-validation-error"></span>
                <div class="form-text">Unique stock keeping unit. Stored in uppercase.</div>
            </div>
            <div class="col-md-7">
                <label asp-for="Name" class="form-label">Product name <span class="text-danger" aria-hidden="true">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="AeroBook 14 Laptop" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"
                          placeholder="Short description shown on product details"></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>
        </div>
    </div>

    <div class="form-section">
        <div class="form-section-title">Classification</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label">Category <span class="text-danger" aria-hidden="true">*</span></label>
                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                    <option value="">Select a category</option>
                </select>
                <span asp-validation-for="CategoryId" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="UnitId" class="form-label">Unit of measurement <span class="text-danger" aria-hidden="true">*</span></label>
                <select asp-for="UnitId" asp-items="Model.Units" class="form-select">
                    <option value="">Select a unit</option>
                </select>
                <span asp-validation-for="UnitId" class="field-validation-error"></span>
            </div>
        </div>
    </div>

    <div class="form-section">
        <div class="form-section-title">Pricing and stock thresholds</div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="CostPrice" class="form-label">Cost price (Rs)</label>
                <input asp-for="CostPrice" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="CostPrice" class="field-validation-error"></span>
                <div class="form-text">Used as the opening cost basis; weighted average is maintained by receipts.</div>
            </div>
            <div class="col-md-4">
                <label asp-for="SellingPrice" class="form-label">Selling price (Rs)</label>
                <input asp-for="SellingPrice" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="SellingPrice" class="field-validation-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ReorderLevel" class="form-label">Reorder level</label>
                <input asp-for="ReorderLevel" class="form-control" type="number" step="0.001" min="0" />
                <span asp-validation-for="ReorderLevel" class="field-validation-error"></span>
                <div class="form-text">Low-stock reports trigger at or below this quantity.</div>
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Product is active and available for new transactions</label>
                </div>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary" data-loading-label="Saving…">
            <i class="bi bi-check-lg me-1" aria-hidden="true"></i> Save product
        </button>
    </div>
</div>
