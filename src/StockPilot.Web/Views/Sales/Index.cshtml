@model PaginatedList<Sale>
@{
    ViewData["Title"] = "Sales";
    var canManage = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.InventoryStaff);
    var selectedStatus = ViewBag.Status as SaleStatus?;
}

<div class="page-header">
    <div>
        <h1>Sales</h1>
        <p>Draft, complete and audit customer stock issues.</p>
    </div>
    @if (canManage)
    {
        <div class="page-actions">
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i> New sale</a>
        </div>
    }
</div>

<form method="get" asp-action="Index" class="card filter-bar section-gap">
    <div class="filter-grid">
        <div>
            <label for="search" class="form-label">Search</label>
            <input id="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="SO number or customer" />
        </div>
        <div>
            <label for="status" class="form-label">Status</label>
            <select id="status" name="status" class="form-select">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<SaleStatus>())
                {
                    <option value="@status" selected="@(selectedStatus == status)">@status</option>
                }
            </select>
        </div>
        <div>
            <label for="from" class="form-label">From</label>
            <input id="from" type="date" name="from" value="@ViewBag.From" class="form-control" />
        </div>
        <div>
            <label for="to" class="form-label">To</label>
            <input id="to" type="date" name="to" value="@ViewBag.To" class="form-control" />
        </div>
        <div class="filter-actions">
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1" aria-hidden="true"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>

<div class="card table-card">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-receipt" aria-hidden="true"></i>
            <h3>No sales found</h3>
            <p>Create a draft sale to record outgoing stock.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>Sale</th><th>Customer</th><th>Created</th><th>Completed</th><th>Status</th><th class="num">Total</th><th></th></tr></thead>
                <tbody>
                    @foreach (var sale in Model)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@sale.Id" class="strong">@sale.SaleNumber</a></td>
                            <td>@(string.IsNullOrWhiteSpace(sale.CustomerName) ? "Walk-in customer" : sale.CustomerName)</td>
                            <td class="text-muted text-small">@UiHelpers.Date(sale.CreatedAtUtc)</td>
                            <td class="text-muted text-small">@UiHelpers.Date(sale.CompletedAtUtc)</td>
                            <td><span class="badge @UiHelpers.SaleStatusClass(sale.Status)">@sale.Status</span></td>
                            <td class="num">@UiHelpers.Money(sale.TotalAmount)</td>
                            <td class="table-actions">
                                <a asp-action="Details" asp-route-id="@sale.Id" class="btn btn-outline-secondary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="Model" />
    }
</div>
