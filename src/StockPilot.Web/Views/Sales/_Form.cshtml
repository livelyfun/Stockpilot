@model SaleFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small" role="alert"></div>

<div class="card form-card">
    <div class="form-section">
        <div class="form-section-title">Sale details</div>
        <div class="row g-3">
            <div class="col-md-7">
                <label asp-for="CustomerName" class="form-label"></label>
                <input asp-for="CustomerName" class="form-control" placeholder="Customer or walk-in" />
                <span asp-validation-for="CustomerName" class="field-validation-error"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Notes" class="form-label"></label>
                <input asp-for="Notes" class="form-control" placeholder="Optional reference or note" />
                <span asp-validation-for="Notes" class="field-validation-error"></span>
            </div>
        </div>
    </div>

    <div class="form-section">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="form-section-title mb-0">Line items</div>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-add-line>
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Add line
            </button>
        </div>
        @Html.ValidationMessage("Items", new { @class = "field-validation-error" })

        <div class="table-responsive">
            <table class="table line-table align-middle">
                <thead>
                    <tr>
                        <th style="min-width:260px">Product</th>
                        <th style="width:130px" class="num">Quantity</th>
                        <th style="width:150px" class="num">Unit price (Rs)</th>
                        <th style="width:130px" class="num">Line total</th>
                        <th style="width:48px"></th>
                    </tr>
                </thead>
                <tbody data-lines-body>
                    @for (var i = 0; i < Model.Items.Count; i++)
                    {
                        var item = Model.Items[i];
                        <tr class="line-row">
                            <td>
                                <select name="Items[@i].ProductId" class="form-select" data-product-select
                                        aria-label="Product for line @(i + 1)">
                                    <option value="">Select a product</option>
                                    @foreach (var product in Model.Products)
                                    {
                                        <option value="@product.Id"
                                                selected="@(item.ProductId == product.Id)"
                                                data-cost="@product.CostPrice"
                                                data-price="@product.SellingPrice"
                                                data-stock="@product.StockOnHand"
                                                data-unit="@product.UnitCode">
                                            @product.DisplayName
                                        </option>
                                    }
                                </select>
                                <span class="text-small text-muted" data-stock-hint></span>
                                <span asp-validation-for="Items[i].ProductId" class="field-validation-error"></span>
                            </td>
                            <td>
                                <input asp-for="Items[i].Quantity" type="number" step="0.001" min="0.001"
                                       class="form-control num" data-quantity-input />
                                <span asp-validation-for="Items[i].Quantity" class="field-validation-error"></span>
                            </td>
                            <td>
                                <input asp-for="Items[i].UnitPrice" type="number" step="0.01" min="0"
                                       class="form-control num" data-price-input />
                                <span asp-validation-for="Items[i].UnitPrice" class="field-validation-error"></span>
                            </td>
                            <td class="num"><span class="line-total" data-line-total>Rs 0.00</span></td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-danger-soft" data-remove-line
                                        aria-label="Remove line @(i + 1)" @(Model.Items.Count <= 1 ? "disabled" : null)>
                                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <template data-line-template>
            <tr class="line-row">
                <td>
                    <select name="Items[__index__].ProductId" class="form-select" data-product-select aria-label="Product">
                        <option value="">Select a product</option>
                        @foreach (var product in Model.Products)
                        {
                            <option value="@product.Id"
                                    data-cost="@product.CostPrice"
                                    data-price="@product.SellingPrice"
                                    data-stock="@product.StockOnHand"
                                    data-unit="@product.UnitCode">
                                @product.DisplayName
                            </option>
                        }
                    </select>
                    <span class="text-small text-muted" data-stock-hint></span>
                </td>
                <td><input name="Items[__index__].Quantity" type="number" step="0.001" min="0.001" value="1" class="form-control num" data-quantity-input /></td>
                <td><input name="Items[__index__].UnitPrice" type="number" step="0.01" min="0" value="0" class="form-control num" data-price-input /></td>
                <td class="num"><span class="line-total" data-line-total>Rs 0.00</span></td>
                <td class="text-end">
                    <button type="button" class="btn btn-sm btn-danger-soft" data-remove-line aria-label="Remove line">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </td>
            </tr>
        </template>

        <div class="callout mt-3">
            <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
            This creates a <strong>draft</strong>. Stock is deducted only when you complete the sale,
            and availability is checked again at that moment.
        </div>
    </div>

    <div class="form-actions justify-content-between">
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted text-small">Estimated total</span>
            <strong class="fs-5" data-order-total>Rs 0.00</strong>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary" data-loading-label="Saving…">
                <i class="bi bi-save me-1" aria-hidden="true"></i> Save draft
            </button>
        </div>
    </div>
</div>
