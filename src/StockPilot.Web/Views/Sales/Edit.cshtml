@model SaleFormViewModel
@{
    ViewData["Title"] = "Edit draft sale";
}
<div class="page-header">
    <div>
        <nav aria-label="Breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Sales</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit draft</li>
        </ol></nav>
        <h1>Edit draft sale</h1>
        <p>Line items can be changed only while the sale is still a draft and no stock has been issued.</p>
    </div>
</div>
<form asp-action="Edit" method="post" data-lines-form="sale" novalidate>
    <partial name="_Form" model="Model" />
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
