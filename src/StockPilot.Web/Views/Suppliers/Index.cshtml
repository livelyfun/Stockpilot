@model PaginatedList<Supplier>
@{
    ViewData["Title"] = "Suppliers";
    var canManage = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.InventoryStaff);
    var includeInactive = (bool)(ViewBag.IncludeInactive ?? false);
}

<div class="page-header">
    <div>
        <h1>Suppliers</h1>
        <p>Supply partners, contact details and purchase history.</p>
    </div>
    @if (canManage)
    {
        <div class="page-actions">
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i> New supplier</a>
        </div>
    }
</div>

<form method="get" asp-action="Index" class="card filter-bar section-gap">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label for="search" class="form-label">Search suppliers</label>
            <input id="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Business, contact or email" />
        </div>
        <div class="col-md-3">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="includeInactive" name="includeInactive" value="true" checked="@includeInactive" />
                <label class="form-check-label" for="includeInactive">Show inactive</label>
            </div>
        </div>
        <div class="col-md-4 filter-actions">
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1" aria-hidden="true"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>

<div class="card table-card">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-truck" aria-hidden="true"></i>
            <h3>No suppliers found</h3>
            <p>Add a supplier to start recording purchases.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>Supplier</th><th>Contact</th><th>Phone</th><th class="num">Purchases</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var supplier in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@supplier.Id" class="strong link-quiet">@supplier.BusinessName</a>
                                <span class="table-sub">@(supplier.Email ?? "No email on file")</span>
                            </td>
                            <td>@(supplier.ContactPerson ?? "—")</td>
                            <td class="text-muted">@(supplier.Phone ?? "—")</td>
                            <td class="num">@supplier.Purchases.Count</td>
                            <td>
                                @if (supplier.IsActive)
                                {
                                    <span class="badge badge-soft-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-secondary">Inactive</span>
                                }
                            </td>
                            <td class="table-actions">
                                <a asp-action="Details" asp-route-id="@supplier.Id" class="btn btn-outline-secondary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="Model" />
    }
</div>
