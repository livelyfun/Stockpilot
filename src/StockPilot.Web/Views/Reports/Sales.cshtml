@model SaleReportPageViewModel
@{
    ViewData["Title"] = "Sales report";
    var filter = Model.Filter;
}

<div class="page-header">
    <div>
        <nav aria-label="Breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
            <li class="breadcrumb-item active" aria-current="page">Sales</li>
        </ol></nav>
        <h1>Sales report</h1>
        <p>Customer sales and revenue. Completed totals exclude drafts, cancelled and reversed sales.</p>
    </div>
    <div class="page-actions">
        <a asp-action="ExportSales"
           asp-route-search="@filter.Search" asp-route-status="@filter.Status"
           asp-route-from="@filter.From?.ToString("yyyy-MM-dd")" asp-route-to="@filter.To?.ToString("yyyy-MM-dd")"
           class="btn btn-outline-secondary">
            <i class="bi bi-download me-1" aria-hidden="true"></i> Export CSV
        </a>
    </div>
</div>

<div class="stat-grid stat-grid-four section-gap">
    <div class="stat-card">
        <div class="stat-top">
            <div>
                <div class="stat-label">Documents</div>
                <div class="stat-value">@Model.Summary.DocumentCount</div>
                <div class="stat-meta">Matching current filters</div>
            </div>
            <span class="stat-icon"><i class="bi bi-receipt" aria-hidden="true"></i></span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-top">
            <div>
                <div class="stat-label">Completed</div>
                <div class="stat-value">@Model.Summary.CompletedCount</div>
                <div class="stat-meta">@UiHelpers.Money(Model.Summary.CompletedTotal) revenue</div>
            </div>
            <span class="stat-icon"><i class="bi bi-check-circle" aria-hidden="true"></i></span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-top">
            <div>
                <div class="stat-label">Draft</div>
                <div class="stat-value">@Model.Summary.DraftCount</div>
                <div class="stat-meta">Not yet issued</div>
            </div>
            <span class="stat-icon"><i class="bi bi-pencil-square" aria-hidden="true"></i></span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-top">
            <div>
                <div class="stat-label">Cancelled / reversed</div>
                <div class="stat-value">@(Model.Summary.CancelledCount + Model.Summary.ReversedCount)</div>
                <div class="stat-meta">@Model.Summary.ReversedCount reversed sales</div>
            </div>
            <span class="stat-icon"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></span>
        </div>
    </div>
</div>

<form method="get" asp-action="Sales" class="card filter-bar section-gap">
    <div class="filter-grid">
        <div>
            <label for="search" class="form-label">Search</label>
            <input id="search" name="search" value="@filter.Search" class="form-control" placeholder="SO number or customer" />
        </div>
        <div>
            <label for="status" class="form-label">Status</label>
            <select id="status" name="status" class="form-select">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<SaleStatus>())
                {
                    <option value="@status" selected="@(filter.Status == status)">@status</option>
                }
            </select>
        </div>
        <div>
            <label for="from" class="form-label">From</label>
            <input id="from" type="date" name="from" value="@filter.From?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div>
            <label for="to" class="form-label">To</label>
            <input id="to" type="date" name="to" value="@filter.To?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="filter-actions">
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1" aria-hidden="true"></i> Filter</button>
            <a asp-action="Sales" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>

<div class="card table-card">
    @if (Model.Rows.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-receipt" aria-hidden="true"></i>
            <h3>No sales match this report</h3>
            <p>Adjust the filters or complete a sale to see results.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr><th>Sale</th><th>Customer</th><th>Status</th><th class="num">Lines</th><th class="num">Total</th><th>Created</th><th>Completed</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td><a asp-controller="Sales" asp-action="Details" asp-route-id="@row.Id" class="strong mono">@row.Number</a></td>
                            <td>@(string.IsNullOrWhiteSpace(row.Customer) ? "Walk-in customer" : row.Customer)</td>
                            <td><span class="badge @UiHelpers.SaleStatusClass(row.Status)">@row.Status</span></td>
                            <td class="num">@row.LineCount</td>
                            <td class="num money">@UiHelpers.Money(row.TotalAmount)</td>
                            <td class="text-muted text-small">@UiHelpers.Date(row.CreatedAtUtc)</td>
                            <td class="text-muted text-small">@UiHelpers.Date(row.CompletedAtUtc)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="Model.Rows" />
    }
</div>
